# Cloud Run environment example for ai-gateway
# Copy these values into your deployment configuration or Secret Manager-backed env vars.

PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Required auth
GATEWAY_MASTER_KEY=replace-me

# Optional rollout controls
REQUIRE_TENANT_ID=false
MAX_CONCURRENT_REQUESTS=50
MAX_FALLBACK_ATTEMPTS=3

# Tenant policy example
# Keep this JSON on one line when setting it as an environment variable.
TENANT_POLICIES_JSON={"tenant-a":{"allowedProviders":["openai"],"allowedModels":["gpt-4o-mini"],"maxTokens":1024,"maxConcurrentRequests":5},"tenant-b":{"allowedProviders":["claude","openai"],"maxTokens":2048,"maxConcurrentRequests":10}}

# CORS
CORS_ORIGINS=https://example.com,https://app.example.com

# Platform Persona (Optional: set to true to enable intelligent system prompts)
PLATFORM_SYSTEM_PROMPTS_ENABLED=false

# Provider credentials
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GOOGLE_API_KEY=replace-me
XAI_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
